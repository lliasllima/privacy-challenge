# Runtime
NODE_ENV=development

# API
API_PORT=3000

# Front (nginx)
FRONT_PORT=8080

# PostgreSQL (host)
POSTGRES_PORT=5432

# PostgreSQL (API connection). Docker Compose overrides DB_HOST to "postgres".
DB_HOST=localhost
DB_PORT=5432
DB_USER=seguir_criadora
DB_PASSWORD=change_me_local_only
DB_NAME=seguir_criadora

# Testes e2e (banco separado, no mesmo container; precisa terminar com "_test")
TEST_DB_NAME=followers_test
